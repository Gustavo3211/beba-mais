{
  "expo": {
    "name": "BEBA+",
    "slug": "beba-mais",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080f16",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bebaplus.app"
    },
    "android": {
      "package": "com.bebaplus.app",
      "edgeToEdgeEnabled": true,
      "permissions": ["android.permission.NFC"]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#5eead4"
        }
      ],
      "expo-sharing",
      "expo-audio"
    ]
  }
}
